# =============================================================================
# Configuração da formação
#
# 1. Copia este ficheiro:      cp .env.exemplo .env
# 2. Abre o .env e preenche a HF_API_KEY (as outras já têm valores que servem).
# 3. Verifica:                 uv run passo00_verificar.py
#
# O .env tem a TUA chave: nunca o partilhes nem o envies para o git
# (o .gitignore já o protege).
# =============================================================================

# A tua chave da Hugging Face (começa por "hf_").
# Como obter: https://huggingface.co/settings/tokens → "Create new token"
#   → tipo "Fine-grained" → ativa "Make calls to Inference Providers" → cria e copia.
HF_API_KEY=hf_coloca_aqui_a_tua_chave

# O endereço para onde vão os pedidos: o "router" da Hugging Face, que
# encaminha cada pedido para um fornecedor que tenha o modelo. Não mudes.
HF_BASE_URL=https://router.huggingface.co/v1

# O modelo (o LLM) usado nos passos 1 a 11.
# O gpt-oss-20b é rápido e barato, mas às vezes engana-se — o que também ensina.
# Alternativa mais forte (e mais cara): openai/gpt-oss-120b
HF_MODEL=openai/gpt-oss-20b

# Quanto o modelo "pensa" antes de responder: low | medium | high.
# Mais esforço = respostas mais cuidadas, mas mais lentas e com mais tokens.
HF_REASONING_EFFORT=low

# O modelo usado pelos agentes do passo 12 (vários agentes a conversar).
# Aqui usamos o 120b porque o 20b falhava ~1 em cada 4 chamadas de ferramentas.
BLACKBOARD_MODEL=openai/gpt-oss-120b
